<Project>
  <PropertyGroup>
    <!-- Single source of truth for default manager version; overridden in CI via -p:Version=X.Y.Z -->
    <Version Condition="'$(Version)' == ''">1.3.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    When running on .NET 10 SDK 10.0.203, the SDK automatically injects its bundled
    Microsoft.DotNet.ILCompiler 10.0.7 during Release Native AOT publish (GHSA-p3jp-9v83-76w9).
    Explicitly overriding Microsoft.DotNet.ILCompiler via PackageReference breaks SDK targets;
    suppress this SDK-bundled audit advisory until the host .NET 10 SDK is upgraded.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p3jp-9v83-76w9" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <StripSymbols>true</StripSymbols>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <TrimmerRootAssembly Include="CommandLine" />
        <TrimmerRootAssembly Include="YGORogueDuelistCardModInstaller" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YGORogueDuelistCardModInstaller.Core\YGORogueDuelistCardModInstaller.Core.csproj" />
    </ItemGroup>

</Project>
